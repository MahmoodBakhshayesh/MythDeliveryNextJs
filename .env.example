NEXT_PUBLIC_API_URL=http://localhost:5128
NEXT_PUBLIC_WS_URL=http://localhost:5128

# Optional: map tile provider (Leaflet)
# For Map.ir, set URL/attribution from their current docs.
# Example placeholders:
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# NEXT_PUBLIC_MAP_API_KEY=your-map-api-key
# You can reference key in URL/attribution with {mapApiKey}
# NEXT_PUBLIC_MAP_USE_WMS=true
# NEXT_PUBLIC_MAP_WMS_LAYERS=Shiveh:ShivehGSLD256
# NEXT_PUBLIC_MAP_WMS_FORMAT=image/png
# MythDeliveryWebApi — copy to .env.local and restart `npm run dev`.
#
# Kestrel profiles (dotnet run): http://localhost:5128
#
# IIS Express (launchSettings): HTTP is http://localhost:9705 — HTTPS is https://localhost:44390
# Port 44390 is sslPort (TLS only). Using http:// on 44390 causes ERR_CONNECTION_RESET.
#
# NEXT_PUBLIC_API_URL=https://localhost:44390
# NEXT_PUBLIC_WS_URL=https://localhost:44390
#
# Or use IIS Express HTTP on 9705 (no TLS):
# NEXT_PUBLIC_API_URL=http://localhost:9705
# NEXT_PUBLIC_WS_URL=http://localhost:9705

NEXT_PUBLIC_API_URL=http://localhost:5128
NEXT_PUBLIC_WS_URL=http://localhost:5128
